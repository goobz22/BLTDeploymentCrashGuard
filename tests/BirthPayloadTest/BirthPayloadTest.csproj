<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <AssemblyName>BirthPayloadTest</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Link the ACTUAL shipping payload model — the test compiles the same source the mod runs,
         so a wire-format change that breaks round-trip fails this test, not a stale copy. -->
    <Compile Include="..\..\Payload\PregnancySync\BirthPayloadData.cs" />
    <Compile Include="..\..\Payload\PregnancySync\BirthWireFraming.cs" />
  </ItemGroup>
</Project>
