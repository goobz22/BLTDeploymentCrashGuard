<Project Sdk="Microsoft.NET.Sdk">

  <!-- PAYLOAD: all guards/fixes/tracers (BLTDeploymentCrashGuard.Payload.dll). Hot-reloadable.
       References the harness for IPayload/ISharedState/Log/Diag/GuardConfig/SelfHealing. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- The FILE is always BLTDeploymentCrashGuard.Payload.dll (TargetName), but the assembly's
         internal NAME is stamped per build. Reason (field-proven 2026-09-01 17:37): the hot-reload
         engine loads every generation via Assembly.LoadFrom, and the LoadFrom context dedups
         simple-named assemblies by NAME ONLY — a dropped build with a new version but the same
         name came back as the already-loaded generation ("LoadFrom deduped to already-loaded
         1.2.7.42191"). A unique name per build is the only identity LoadFrom cannot collapse,
         and LoadFrom-context binding is required for the payload to bind the harness's own
         0Harmony copy (see HotReload.cs). Nothing depends on the internal name: the harness
         finds PayloadEntry by type name, tests link source files, SubModule.xml lists only
         the harness. -->
    <!-- csc names the assembly after its OUTPUT FILE, so the stamp must be the compile-time
         output name; the PublishFixedPayloadName target below copies it to the fixed file name
         (the internal identity keeps the stamp). -->
    <PayloadBuildStamp>$([System.DateTime]::UtcNow.ToString("yyMMddHHmmss"))</PayloadBuildStamp>
    <AssemblyName>BLTDeploymentCrashGuard.Payload.b$(PayloadBuildStamp)</AssemblyName>
    <PayloadFixedFileName>BLTDeploymentCrashGuard.Payload.dll</PayloadFixedFileName>
    <RootNamespace>BLTDeploymentCrashGuard</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <!-- Every payload BUILD gets a unique AssemblyVersion revision (wildcard needs
         Deterministic=false). The hot-reload engine loads each generation via LoadFrom,
         which dedups identical identities — without a fresh revision a reload would get
         the PREVIOUS generation back instead of the dropped build. See HotReload.cs. -->
    <Deterministic>false</Deterministic>
    <AssemblyVersion>$(Version).*</AssemblyVersion>
    <!-- FileVersion must stay a literal (wildcards are illegal in AssemblyFileVersion
         and would otherwise be inherited from the AssemblyVersion above). -->
    <FileVersion>$(Version).0</FileVersion>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameDir>
    <GameBin>$(GameDir)\bin\Win64_Shipping_Client</GameBin>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Harness types (IPayload, Log, Diag, GuardConfig, SelfHealing). Do not copy the harness
         DLL into the payload output — it ships once as the loaded module. -->
    <ProjectReference Include="..\Harness\BLTDeploymentCrashGuard.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.DotNet">
      <HintPath>$(GameBin)\TaleWorlds.DotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(GameBin)\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(GameBin)\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(GameBin)\TaleWorlds.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(GameBin)\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(GameBin)\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(GameBin)\TaleWorlds.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(GameBin)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Publish the stamped-name build under the fixed file name the harness/installer expect,
       and drop the stamped-name copy so bin/ holds exactly one payload. -->
  <Target Name="PublishFixedPayloadName" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(OutDir)$(PayloadFixedFileName)" />
    <Delete Files="$(TargetPath)" />
  </Target>

</Project>
